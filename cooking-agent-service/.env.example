# Copy to .env and adjust for your environment.
# pydantic-settings loads values from .env (see app/core/config.py).

# Application name shown in logs and FastAPI docs title.
APP_NAME=Cooking Agent Service

# Enable debug mode (affects error verbosity).
DEBUG=false

# Logging level for the application: DEBUG / INFO / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO

# 服务启动配置：host/port/reload 由 uvicorn 程序化启动时读取。
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
SERVER_RELOAD=false

# 主模型供应方：custom（OpenAI 兼容自定义服务）/ ollama（本地）/ deepseek（官方）。
# 仅实例化被选中的供应方，其余供应方无需配置密钥。
LLM_PROVIDER=custom

# 本地 Ollama 服务地址与默认模型。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# 自定义服务端
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# DeepSeek 大模型接入地址、模型与 API Key（密钥请勿提交到仓库）。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# 对接接口
API_RECIPES_QUERY=http://localhost:8000/api/recipes
API_RECIPE_DETAIL_QUERY=http://localhost:8000/api/recipes/detail
API_TIMEOUT=30