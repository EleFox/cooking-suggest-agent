# Copy to .env and adjust for your environment.
# pydantic-settings loads values from .env (see app/core/config.py).

# Application name shown in logs and FastAPI docs title.
APP_NAME=Cooking Web Service

# Enable debug mode (affects error verbosity).
DEBUG=false

# Logging level for the application: DEBUG / INFO / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO

# Agent Service integration URL.
AGENT_SERVICE_URL=http://localhost:9000

# Timeout (seconds) for calling the Agent Service.
AGENT_SERVICE_TIMEOUT=600.0

# Dedicated thread pool size for the (long-running) decision chain.
DECISION_MAX_WORKERS=4

# SQLite database file path (relative to the backend directory).
# DATABASE_PATH=cooking.db