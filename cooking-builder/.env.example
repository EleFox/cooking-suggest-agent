# ===========================================================================
# Cooking Suggest 打包/部署环境变量模板
# 使用：cp .env.example .env，按需修改后再执行 docker compose。
# 说明：本文件由 docker compose 自动加载，用于 compose 文件中的变量替换；
#       其中同名变量会被注入到对应容器（见 docker-compose.yml）。
#       服务内部地址（AGENT_SERVICE_URL / API_RECIPES_QUERY 等）由 compose
#       网络自动串联，无需在此配置。
# ===========================================================================

# ---------------------------------------------------------------------------
# 镜像与端口
# ---------------------------------------------------------------------------
# 镜像标签（同一批镜像使用相同 tag，便于回滚）。
IMAGE_TAG=latest

# 目标运行平台（生产服务器架构）。离线包中的镜像按此平台构建。
# 常见：linux/amd64（x86_64 服务器）、linux/arm64（ARM 服务器）。
TARGET_PLATFORM=linux/amd64

# 前端访问端口（对外）。
FRONTEND_PORT=8906
FRONTEND_BIND=0.0.0.0

# 接口后端端口（默认仅本机可访问，便于调试；对外访问请走前端 Nginx）。
WEB_BACKEND_PORT=8000

# Agent 服务端口（默认仅本机可访问，仅供接口后端在 compose 网络内调用）。
AGENT_SERVICE_PORT=9000

# 上述两个“仅本机”服务的绑定地址；如需局域网直连改为 0.0.0.0。
LOCAL_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# 持久化数据（SQLite + 菜谱 Markdown）
# ---------------------------------------------------------------------------
# 数据源，映射到 web-backend 的 /app/datas。升级/重建容器不会删除数据。
#   1) 宿主机目录（默认，便于直接备份与迁移老数据）：
#        WEB_DATA_SOURCE=./data/web
#   2) 命名卷（Docker Desktop 上 SQLite 文件锁更稳，推荐 macOS/Windows）：
#        WEB_DATA_SOURCE=cooking-web-datas
#        WEB_DATA_VOLUME_NAME=cooking-web-datas
WEB_DATA_SOURCE=./data/web
WEB_DATA_VOLUME_NAME=cooking-web-datas

# SQLite 数据库文件名（位于上述数据源内）。
DB_FILENAME=cooking.db

# ---------------------------------------------------------------------------
# 通用服务配置（两个后端共用）
# ---------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# web-backend
# ---------------------------------------------------------------------------
WEB_APP_NAME=Cooking Web Service
# 调用 Agent 的超时上限（秒）。
AGENT_SERVICE_TIMEOUT=600.0
# 决策链路专用线程池大小。
DECISION_MAX_WORKERS=4

# ---------------------------------------------------------------------------
# agent-service
# ---------------------------------------------------------------------------
AGENT_APP_NAME=Cooking Agent Service

# 主模型供应方：custom（OpenAI 兼容自定义服务，默认）/ ollama（本地）/ deepseek（官方）。
# 仅实例化被选中的供应方，其余供应方无需配置密钥。
LLM_PROVIDER=custom

# 本地 Ollama（host.docker.internal 指向宿主机；也可填局域网地址）。
OLLAMA_BASE_URL=http://192.168.123.35:11434
OLLAMA_MODEL=qwen3.5:9b

# OpenAI 兼容的自定义服务（当前 Agent 默认使用的 LLM）。
CUSTOM_BASE_URL=https://opencode.ai/zen/go/v1
CUSTOM_MODEL=deepseek-v4.1-flash
# 密钥请填写在 .env 中，切勿提交到仓库。
CUSTOM_API_KEY=

# DeepSeek 官方接口（备用）。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Agent 反向调用 web-backend 菜谱接口的超时（秒）。
API_TIMEOUT=30
